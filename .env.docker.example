# ==============================================================================
# Docker Environment Overrides (.env.docker)
# ==============================================================================
# If your primary .env points to a cloud database (e.g. Supabase) and you want
# your Docker containers to connect to the local containerized PostgreSQL instead,
# copy this file to `.env.docker`:
#
#   cp .env.docker.example .env.docker   (or `copy` on Windows PowerShell)
#
# Docker Compose will load .env.docker over .env.
# ==============================================================================

# Internal Docker Compose connection to the containerized PostgreSQL database:
DATABASE_URL=postgresql://postgres:postgres@db:5432/sales_reimbursement?sslmode=disable
DIRECT_URL=postgresql://postgres:postgres@db:5432/sales_reimbursement?sslmode=disable

# Demo mode & authentication settings
DEMO_MODE=true
AUTH_MODE=demo
ENABLE_DEMO_LOGIN=true
AUTO_SEED=true
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_ENABLE_ALL_CLAIM_TYPES=false

# Port inside container
PORT=3000
NODE_ENV=development
