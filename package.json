{
  "name": "sales-reimbursement-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "overrides": {
    "body-parser": {
      "qs": "^6.16.0"
    }
  },
  "scripts": {
    "postinstall": "prisma generate --config prisma.config.ts",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:legacy-backend": "npm run dev --workspace backend",
    "build": "next build",
    "build:legacy-backend": "npm run build --workspace backend",
    "vercel-build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:legacy-backend": "npm run start --workspace backend",
    "clean": "rimraf .next && npm run clean --workspace backend",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma.config.ts",
    "db:status": "prisma migrate status --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/material-symbols-outlined": "^5.3.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "jspdf": "^4.2.1",
    "next": "^16.3.5",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "pg-mem": "^3.0.14",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11"
  }
}
