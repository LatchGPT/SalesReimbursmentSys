# FRONTEND (Vercel and local Next.js)
# Public Render API origin, without a trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://salesreimbursmentsystem.onrender.com
# Keep true only while the demo account picker is intentionally exposed.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# BACKEND (Render and local Express)
PORT=3000
NODE_ENV=development
# Comma-separated browser origins allowed by CORS. Do not add a trailing slash.
ALLOWED_ORIGINS=https://sales-reimbursment-system.vercel.app,http://localhost:3001

# Runtime URL: Supabase transaction pooler (PgBouncer), used by Vercel functions.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DATABASE_POOL_MAX=1
# Administrative URL: direct Supabase connection, used only by Prisma CLI
# migrations/introspection. Never expose this variable to the browser.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Demo/prototype switches. Set all three to false before handling real data.
DEMO_MODE=true
AUTH_MODE=demo
ENABLE_DEMO_LOGIN=true
AUTO_SEED=true
ENABLE_ALL_CLAIM_TYPES=0

# Backend-only Microsoft identity configuration (not yet production-ready).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://salesreimbursmentsystem.onrender.com/api/auth/microsoft/callback
SESSION_SECRET=
GRAPH_SCOPES=
LOG_LEVEL=info
# Server-only integrations for the unified Vercel application.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# Optional Render persistent-disk mount. Defaults to backend/uploads locally.
UPLOAD_DIR=
