# PUBLIC BROWSER VALUES (inlined by Next.js at build time)
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_ENABLE_ALL_CLAIM_TYPES=false

# UNIFIED NEXT.JS SERVER (Vercel and local)
PORT=3000
NODE_ENV=development
# Used only by the retained legacy Render/Express service during cutover.
ALLOWED_ORIGINS=https://sales-reimbursment-system.vercel.app,http://localhost:3001

# Runtime URL: Supabase transaction pooler (PgBouncer), used by Vercel functions.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
DATABASE_POOL_MAX=1
# Administrative URL used only by deliberate Prisma migration/introspection
# commands. It is not required by `npm ci`, `npm run build`, or Vercel runtime.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Demo/prototype switches. Set all three to false before handling real data.
DEMO_MODE=true
AUTH_MODE=demo
ENABLE_DEMO_LOGIN=true
AUTO_SEED=true
ENABLE_ALL_CLAIM_TYPES=0

# Backend-only Microsoft identity configuration (not yet production-ready).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://sales-reimbursment-system.vercel.app/api/auth/microsoft/callback
SESSION_SECRET=
GRAPH_SCOPES=
# Server-only integrations for the unified Vercel application.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
# Optional legacy Render persistent-disk mount.
UPLOAD_DIR=
